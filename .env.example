# Requeridas por la plataforma institucional y su autenticación.
# En Vercel / Netlify, definir ambas variables en el entorno de producción
# ANTES del build. Vite las incorpora al bundle; cambiarlas requiere recompilar.
# Solo claves públicas anon o sb_publishable_; nunca service_role / sb_secret_.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Buckets: media (público), documents (privado).
VITE_PROJECT_RECEIPTS_BUCKET=documents

# Edge Function secrets only. Configure with Supabase secrets, never VITE_*.
# RESEND_API_KEY
# APPROVAL_EMAIL_FROM (verified sender)
# APP_SITE_URL (canonical application URL)

# Solo CLI local / CI privado para migraciones y auditoría SQL. Nunca VITE_*.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
