# Requeridas por la plataforma institucional y su autenticación.
# En Vercel, definir también en Settings > Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Contrato de Storage tras aplicar 20261020110000_tenant_storage.sql.
# Buckets: media (publico), documents (privado); prefijo institution_id UUID/.
VITE_PROJECT_RECEIPTS_BUCKET=documents

# Edge Function secrets only; configure in Supabase, never VITE_*.
# RESEND_API_KEY
# APPROVAL_EMAIL_FROM
# APP_SITE_URL
