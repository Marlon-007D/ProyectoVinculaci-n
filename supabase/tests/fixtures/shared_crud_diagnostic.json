    "access_definitions": [
        {
            "signature": "is_super_admin()",
            "definition": "CREATE OR REPLACE FUNCTION public.is_super_admin()\\n RETURNS boolean\\n LANGUAGE sql\\n STABLE SECURITY DEFINER\\n SET search_path TO ''\\nAS $function$\\r\\n  SELECT auth.uid() IS NOT NULL AND EXISTS (\\r\\n    SELECT 1 FROM public.memberships m\\r\\n    JOIN public.roles r ON r.role_id = m.role_id\\r\\n    JOIN public.institutions i ON i.institution_id = m.institution_id\\r\\n    WHERE m.profile_id = auth.uid() AND m.is_active AND i.is_active\\r\\n      AND r.name::text = 'super_admin'\\r\\n  );\\r\\n$function$\\n"
        },
        {
            "signature": "project_can_manage(uuid)",
            "definition": "CREATE OR REPLACE FUNCTION public.project_can_manage(target uuid)\\n RETURNS boolean\\n LANGUAGE sql\\n STABLE SECURITY DEFINER\\n SET search_path TO 'public', 'pg_temp'\\nAS $function$\\r\\n  SELECT auth.uid() IS NOT NULL AND public.project_module_enabled(target) AND (\\r\\n    public.is_super_admin() OR EXISTS (\\r\\n      SELECT 1 FROM public.memberships m JOIN public.roles r USING (role_id)\\r\\n      WHERE m.profile_id = auth.uid() AND m.institution_id = target\\r\\n        AND r.name IN ('institution_admin', 'project_manager')));\\r\\n$function$\\n"
        },
        {
            "signature": "project_can_publish(uuid)",
            "definition": "CREATE OR REPLACE FUNCTION public.project_can_publish(target uuid)\\n RETURNS boolean\\n LANGUAGE sql\\n STABLE SECURITY DEFINER\\n SET search_path TO 'public', 'pg_temp'\\nAS $function$\\r\\n  SELECT public.project_can_manage(target) AND (public.is_super_admin() OR EXISTS (\\r\\n    SELECT 1 FROM public.memberships m JOIN public.roles r USING (role_id)\\r\\n    WHERE m.profile_id = auth.uid() AND m.institution_id = target AND r.name = 'institution_admin'));\\r\\n$function$\\n"
        },
        {
            "signature": "project_module_enabled(uuid)",
            "definition": "CREATE OR REPLACE FUNCTION public.project_module_enabled(target uuid)\\n RETURNS boolean\\n LANGUAGE sql\\n STABLE SECURITY DEFINER\\n SET search_path TO 'public', 'pg_temp'\\nAS $function$\\r\\n  SELECT EXISTS (SELECT 1 FROM public.institutions WHERE institution_id = target AND is_active)\\r\\n    AND NOT EXISTS (SELECT 1 FROM public.module_settings\\r\\n      WHERE institution_id = target AND module_name = 'projects' AND NOT is_enabled);\\r\\n$function$\\n"
        }
    ]
}