{
  "name": "simuladores-educativos-brigitte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/check-production-env.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && vercel --prod",
    "db:backup-public": "node scripts/backup-public-schema.mjs",
    "db:migrate": "node scripts/apply-drizzle-migrations.mjs",
    "db:verify-production": "node scripts/verify-production-backend.mjs",
    "db:seed:course-catalog": "node --experimental-strip-types scripts/seed-course-catalog.ts",
    "db:generate": "drizzle-kit generate --name baseline_invoice_catalog",
    "db:seed:invoice-catalog": "node --experimental-strip-types scripts/seed-invoice-products.ts",
    "test:db-security": "node --test tests/integration/database-security.test.mjs",
    "test:db-crud": "node --experimental-strip-types --test tests/integration/invoice-repository.test.mjs tests/integration/invoice-rest.test.mjs",
    "test:security": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/security/*.test.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "portable": "node server.mjs",
    "lint": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:projects": "node --test --test-isolation=none supabase/tests/frontend_projects.test.cjs supabase/tests/xlsx_writer.test.cjs supabase/tests/projects_forms_reports.test.cjs supabase/tests/single_instance.test.cjs supabase/tests/notify_adapter.test.cjs supabase/tests/portal_updates.test.cjs supabase/tests/shared_integration.test.cjs",
    "test:admin": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"src/**/!(*.database).test.mjs\"",
    "test:integration": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"tests/security/*.test.mjs\" supabase/tests/public_client.test.mjs supabase/tests/invite_institution_user.test.mjs",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "test:coverage": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test --experimental-test-coverage \"--test-coverage-include=src/**\" \"--test-coverage-exclude=**/*.test.mjs\" \"--test-coverage-exclude=**/mocks/**\" --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=dot --test-reporter-destination=stdout \"src/**/!(*.database).test.mjs\"",
    "test:all": "npm run test:projects && npm run test:admin && npm run test:integration"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@supabase/supabase-js": "^2.117.3",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "jspdf": "^4.2.1",
    "lucide-react": "latest",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "supabase": "^2.121.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
